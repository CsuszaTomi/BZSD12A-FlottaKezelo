<Window x:Class="Classic.Windows.Autok"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Classic.Windows"
        mc:Ignorable="d"
        Background="AliceBlue"
        Title="Autók" Height="560" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="3.5*"/>
            <RowDefinition Height="6.5*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Felső szekció: Autó adatai -->
        <Label Content="Autó adatai" Margin="5,3,5,0"
               Height="25" Grid.Row="0" Grid.Column="0"
               Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalContentAlignment="Center" Background="Bisque"/>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="5,30,5,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Label Content="Id:" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <TextBox x:Name="tbxId" Width="55" Margin="5,0,10,0" VerticalContentAlignment="Center" FontSize="15" IsReadOnly="True" Background="LightGray"/>

                <Label Content="Rendszám:" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <TextBox x:Name="tbxPlate" Width="110" Margin="5,0,10,0" VerticalContentAlignment="Center" FontSize="15" FontWeight="Bold" MaxLength="16"/>

                <Label Content="Alvázszám:" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <TextBox x:Name="tbxChassis" Width="200" Margin="5,0,10,0" VerticalContentAlignment="Center" FontSize="15" FontWeight="Bold" MaxLength="64"/>

                <Label Content="Gyártási dátum:" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <DatePicker x:Name="dpCarYear" Width="140" Margin="5,0,5,0" VerticalContentAlignment="Center" FontSize="15"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Label Content="Gyártó:" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <ComboBox x:Name="cbxBrand" Width="150" Margin="5,0,10,0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                          DisplayMemberPath="BrandName" SelectedValuePath="Id" SelectionChanged="cbxBrand_SelectionChanged"/>

                <Label Content="Modell:" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <ComboBox x:Name="cbxModel" Width="150" Margin="5,0,10,0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                          DisplayMemberPath="ModelName" SelectedValuePath="Id"/>

                <Label Content="Felhasználó:" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <ComboBox x:Name="cbxUser" Width="220" Margin="5,0,5,0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Label Content="Fogyasztás (l/100km):" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <TextBox x:Name="tbxConsumption" Width="70" Margin="5,0,10,0" VerticalContentAlignment="Center" FontSize="15"/>

                <Label Content="Futott km:" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <TextBox x:Name="tbxKm" Width="110" Margin="5,0,10,0" VerticalContentAlignment="Center" FontSize="15"/>

                <Label Content="Üzemanyag:" Margin="5,0,0,0" VerticalContentAlignment="Center" FontSize="15"/>
                <ComboBox x:Name="cbxFuel" Width="130" Margin="5,0,5,0" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Lista -->
        <Label Content="Autók listája" Margin="5,3,5,0"
               Height="25" Grid.Row="1" Grid.Column="0"
               Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalContentAlignment="Center" Background="DarkOliveGreen" Foreground="White"/>
        <DataGrid x:Name="dgCars" Grid.Row="1" Grid.ColumnSpan="2" Margin="5,32,5,5"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="dgCars_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="45"/>
                <DataGridTextColumn Header="Rendszám" Binding="{Binding PlateNumber}" Width="90"/>
                <DataGridTextColumn Header="Alvázszám" Binding="{Binding ChassisNumber}" Width="160"/>
                <DataGridTextColumn Header="Gyártó" Binding="{Binding BrandName}" Width="110"/>
                <DataGridTextColumn Header="Modell" Binding="{Binding ModelName}" Width="90"/>
                <DataGridTextColumn Header="Felhasználó" Binding="{Binding UserName}" Width="*"/>
                <DataGridTextColumn Header="Gyártási dátum" Binding="{Binding CarYear, StringFormat=yyyy.MM.dd}" Width="110"/>
                <DataGridTextColumn Header="Fogyasztás" Binding="{Binding Consumption}" Width="100"/>
                <DataGridTextColumn Header="Futott km" Binding="{Binding RanKm}" Width="80"/>
                <DataGridTextColumn Header="Üzemanyag" Binding="{Binding FuelType}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="2">
            <Button x:Name="btnAdd" Margin="5" VerticalAlignment="Center" Width="100" Content="Hozzáad" Click="btnAdd_Click"/>
            <Button x:Name="btnUpdate" Margin="5" VerticalAlignment="Center" Width="100" Content="Módosít" Click="btnUpdate_Click"/>
            <Button x:Name="btnDelete" Margin="5" VerticalAlignment="Center" Width="100" Content="Töröl" Click="btnDelete_Click"/>
            <Button x:Name="btnCancel" Margin="5" VerticalAlignment="Center" Width="100" Content="Mégsem" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>