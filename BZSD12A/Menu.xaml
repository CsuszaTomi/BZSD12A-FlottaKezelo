<Window x:Class="Classic.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Classic"
        mc:Ignorable="d"
        Title="Menu rendszer" Height="450" Width="800"
        x:Name="fomenu">
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_Fájl">
                    <MenuItem Header="adatok _Mentése">
                        <MenuItem.Icon>
                            <Image Source="/Images/backup.jpg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="adatok _Visszatöltése">
                        <MenuItem.Icon>
                            <Image Source="/Images/restore.jpg"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="_Kilépés" Click="Exit" Style="{StaticResource MaterialDesignMenuItem}"/>
                </MenuItem>
                <MenuItem Header="_Adatkarbantartás">
                    <MenuItem Header="Felhasználók adatai" Click="FelhasznalokKarbantartasa"/>
                </MenuItem>
            </Menu>
        </DockPanel>
    </Grid>
</Window>
