<Window x:Class="Classic.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Classic.Windows"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid>
        <Label Content="Felhasználónév:" HorizontalAlignment="Left" Margin="252,120,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txbUserName" HorizontalAlignment="Left" Margin="252,149,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Label Content="Jelszó:" HorizontalAlignment="Left" Margin="252,0,0,0" VerticalAlignment="Center"/>
        <PasswordBox x:Name="pwbPassword" HorizontalAlignment="Left" Margin="252,29,0,0" VerticalAlignment="Center" Width="120"/>
        <Button x:Name="btnBejelentkezes" Content="Bejelentkezés" HorizontalAlignment="Left" Margin="372,338,0,0" VerticalAlignment="Top" Click="btnBejelentkezes_Click"/>


    </Grid>
</Window>
