<Window x:Class="Classic.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Classic.Windows"
        mc:Ignorable="d"
        Background="AliceBlue"
        Title="Login" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Felhasználónév:" VerticalAlignment="Top" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold"/>
            <TextBox x:Name="txbUserName" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" FontSize="20"/>
            <Label Content="Jelszó:" HorizontalContentAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
            <PasswordBox x:Name="pwbPassword" VerticalAlignment="Center" Width="200" FontSize="20"/>
            <Button x:Name="btnBejelentkezes" Content="Bejelentkezés" Margin="5" Height="50"  VerticalAlignment="Top"  Click="btnBejelentkezes_Click" Background="#FF22D8C3" BorderBrush="#FF2830B7"/>
        </StackPanel>
    </Grid>
</Window>
