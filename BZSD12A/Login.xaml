<Window x:Class="Classic.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Classic.Windows"
        mc:Ignorable="d"
        Background="AliceBlue"
        Title="Login" Height="450" Width="800"
        FontFamily="Inter">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="0.8*"/>
        </Grid.RowDefinitions>    
        
        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Felhasználónév:" VerticalAlignment="Center" HorizontalContentAlignment="Left" FontSize="19" FontWeight="Bold"/>
            <TextBox x:Name="txbUserName" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="200" FontSize="19" BorderBrush="Black" BorderThickness="0.5"/>
            <Label Content="Jelszó:" HorizontalContentAlignment="Left" VerticalAlignment="Center" FontSize="19" FontWeight="Bold"/>
            <PasswordBox x:Name="pwbPassword" VerticalAlignment="Center" Width="200" FontSize="19" BorderBrush="Black" BorderThickness="0.5"/>
            <Border BorderBrush="Black" BorderThickness="1.3" CornerRadius="5,0,5,0" Margin="5,10" Background="#FF1DAD27">
                <Button x:Name="btnBejelentkezes" Content="Bejelentkezés" Height="50" VerticalAlignment="Top"  
            Click="btnBejelentkezes_Click" Background="Transparent" BorderThickness="0" FontSize="17" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
